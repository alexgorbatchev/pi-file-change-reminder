{
  "name": "pi-file-change-reminder",
  "version": "2.0.1",
  "description": "Pi extension that injects reminder messages when specific files are modified.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/pi-file-change-reminder.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "reminder"
  ],
  "files": [
    "src/fileChangeReminderExtension.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/fileChangeReminderExtension.ts"
    ]
  },
  "dependencies": {
    "picomatch": "^4.0.5"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "^12.0.0",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@types/bun": "^1.4.2",
    "@types/node": "26.1.1",
    "@types/picomatch": "^4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "fix": "bun --bun oxfmt --write .",
    "check": "bun --bun oxfmt --check . && bun --bun oxlint . && tsgo --noEmit",
    "test": "bun scripts/run-isolated-pi.ts bun test",
    "test:local": "bun x pi -e ./src/fileChangeReminderExtension.ts"
  }
}
